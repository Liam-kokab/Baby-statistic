# Copy this file to ".env" at the repo root and fill in real values for production.
# Loaded automatically via server/src/loadEnv.ts (dotenv). Never commit the real ".env".
#
# Everything below is optional — sensible dev defaults are used for anything left
# unset (see doc/server.md for the full table). In production you should at least
# set JWT_ACCESS_SECRET and JWT_REFRESH_SECRET to long random strings.

# --- Server ---
# PORT=3000
# DB_PATH=./data/baby.db

# --- Auth ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# BCRYPT_ROUNDS=12

# --- Admin bootstrap (only used if no admin user exists yet) ---
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

