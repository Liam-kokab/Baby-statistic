# Copy this file to ".env" at the repo root and fill in real values for production.
# Loaded automatically via server/src/loadEnv.ts (dotenv). Never commit the real ".env".
#
# Everything below is optional — sensible dev defaults are used for anything left
# unset (see doc/server.md for the full table). In production you should at least
# set JWT_ACCESS_SECRET and JWT_REFRESH_SECRET to long random strings.

# --- Server ---
# PORT=3000
# DB_PATH=./data/baby.db
# ALLOWED_ORIGINS=  # comma-separated list of extra allowed CORS origins (leave unset for same-origin only)

# --- Auth ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# BCRYPT_ROUNDS=12

# --- Admin bootstrap (only used if no admin user exists yet) ---
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# --- ddns-keeper (see ddns-keeper/README.md) ---
# Off by default — set DDNS_ENABLED=true to have PM2 register the ddns-keeper
# and ddns-keeper-healthcheck apps (see ecosystem.config.js / doc/pm2.md).
# DDNS_ENABLED=true
DOMENESHOP_TOKEN=
DOMENESHOP_SECRET=
DDNS_HOSTNAME=
# IP_PROVIDER_URL=https://checkip.amazonaws.com
# POLL_INTERVAL_MS=300000
# HTTP_PORT=3000
# Note: ecosystem.config.js overrides HTTP_PORT to 3010 in production (this
# repo's PM2 setup) to avoid clashing with baby-statistic-server on 3000 —
# see doc/ddns-keeper.md. Leave unset unless running ddns-keeper standalone.
# RETRY_MAX_ATTEMPTS=3
# RETRY_BASE_DELAY_MS=500

