[Unit]
Description=Weekly scheduled reboot (Monday 04:30) — see doc/pm2.md

[Timer]
# Every Monday at 04:30 local time — chosen as the quietest/least-likely-
# to-be-in-use window for this app.
OnCalendar=Mon *-*-* 04:30:00
# If the machine was off/asleep at the scheduled time, run it as soon as
# possible after boot instead of silently skipping that week's reboot.
Persistent=true

[Install]
WantedBy=timers.target

