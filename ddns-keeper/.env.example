# Domeneshop API credentials — generate at https://www.domeneshop.no/admin?view=api
DOMENESHOP_TOKEN=
DOMENESHOP_SECRET=

# Fully qualified hostname to keep updated (must exist as an A record in Domeneshop)
DDNS_HOSTNAME=example.com

# Optional overrides — see README.md for full details
# IP_PROVIDER_URL=https://checkip.amazonaws.com
# POLL_INTERVAL_MS=300000
# HTTP_PORT=3000
# RETRY_MAX_ATTEMPTS=3
# RETRY_BASE_DELAY_MS=500

